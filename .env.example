# Copy this file to .env.local and fill it in.
# .env.local is ignored by git — real values must never be committed.

# ─── Required ────────────────────────────────────────────────────────────────

# Your Postgres database — any Postgres works: Neon, Supabase, your host's own,
# or one installed on your VPS.
#
#   Neon:      postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Local:     postgres://user:pass@localhost:5432/bms
#   cPanel:    postgres://cpaneluser_bms:pass@localhost:5432/cpaneluser_bms
#
# Neon URLs are used over HTTPS automatically (right for serverless hosts);
# everything else is a normal TCP connection.
DATABASE_URL=

# Signs the login session. Generate a fresh one — never reuse another site's:
#   openssl rand -base64 32
# (or, without openssl:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Changing it later logs everybody out, which is the safe way to end all
# sessions if you think one has been stolen.
AUTH_SECRET=

# The public address of this site, with no trailing slash. This is what login
# redirects and admin links are built from, so it must be the address visitors
# use — not localhost, not the server's IP.
#   In development: http://localhost:3000
NEXTAUTH_URL=https://example.com

# Required unless you are hosting on Vercel. Without it NextAuth refuses to
# trust the host header and login fails with no useful error.
AUTH_TRUST_HOST=true


# ─── Recommended ─────────────────────────────────────────────────────────────

# Used for canonical URLs, og:url, the sitemap and the feed.
#
# You can instead set Site URL in Settings, which takes priority over this. Set
# it one way or the other before launch: with neither, every canonical tag and
# every sitemap entry points at localhost, and the site gets indexed that way
# without any visible error.
NEXT_PUBLIC_SITE_URL=https://example.com


# ─── Database tuning (usually leave alone) ───────────────────────────────────

# Force a driver instead of guessing from the URL: "neon" (HTTPS) or "postgres" (TCP).
# DB_DRIVER=postgres

# TLS for TCP connections. Default encrypts without verifying the certificate,
# which is what nearly every managed Postgres needs. "verify" once you have a
# CA configured; "off" for a database on localhost that has no TLS at all.
# DB_SSL=off

# Connections this process may hold open. 5 is safe on shared hosting, where
# the account has a small allowance. Raise it on a VPS with its own database.
# DB_POOL_MAX=5


# ─── Optional ────────────────────────────────────────────────────────────────

# Media storage. With a token, uploads go to Vercel Blob; without one they are
# written to public/uploads on the server's own disk.
#
# On Vercel (or any serverless host) the disk is read-only and wiped between
# deploys, so a token is REQUIRED there. On a VPS or shared host, leaving this
# empty is correct and uploads persist normally — include public/uploads in
# your backups.
BLOB_READ_WRITE_TOKEN=

# Image optimisation needs `sharp`, a native module. If images 500 on your
# host after deploying, set this to "off" and the originals are served instead.
# IMAGE_OPTIMIZATION=off

# Contact-form notifications. Leave empty and forms still save submissions to
# the database; they simply do not email anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Spam protection for comments and contact forms with Cloudflare Turnstile
# (free, invisible to people). Cloudflare dashboard → Turnstile → Add site →
# copy both keys. The site key is public and is baked in at BUILD time, so set
# it before `npm run build`; the secret is read at run time on the host.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Scheduled backups. With a token set, GET /api/backup?token=<this> writes a
# full backup (content + uploads) to backups/ next to the app and keeps the
# newest seven. Point a cron at it — cPanel → Cron Jobs → once a day:
#   curl -s "https://example.com/api/backup?token=YOUR_TOKEN" >/dev/null
# Make it long and random (node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
# Runs at most once every BACKUP_MIN_HOURS (default 20), so a leaked token
# cannot overwrite the kept backups by calling it seven times in a row.
# The token can also be sent as a header instead of in the URL, which keeps it
# out of the access logs:  curl -s -H "Authorization: Bearer YOUR_TOKEN" …
BACKUP_TOKEN=
# BACKUP_KEEP=7
# BACKUP_MIN_HOURS=20

# Scheduled publishing + keep-alive. Every 3 minutes, a cron should hit
#   curl -s -o /dev/null -m 30 "https://example.com/api/cron/publish?token=YOUR_TOKEN"
# which pushes posts scheduled for a past time live immediately (pages are
# otherwise cached for up to an hour), pings IndexNow, and keeps the app and
# database awake. Uses CRON_TOKEN, or BACKUP_TOKEN if this is left empty —
# but give it its own token: Site Health warns while the cron borrows the
# backup one. `-H "Authorization: Bearer YOUR_TOKEN"` works instead of
# ?token=, and keeps the token out of the host's access logs.
#
# On a shared host set this to */3 rather than */5: LiteSpeed stops an idle
# app, and a 5-minute ping races a 5-minute idle window and loses often enough
# to matter. Keep the double quotes — without them the shell cuts the URL at
# the "?" and the token never arrives.
#
# MINIMUM 16 CHARACTERS. A shorter secret is treated as "not configured" on
# purpose, and the route then answers 404 to everything — including your cron,
# which will look like it is working while doing nothing at all.
CRON_TOKEN=

# Optional. When set, the first-run setup screen (/admin/setup) asks for this
# before it will create the first administrator — so nobody who finds a fresh
# install before you do can claim it. Remove it after setup if you like.
# SETUP_TOKEN=

# The Updates screen. UPDATE_MANIFEST_URL is a JSON file you publish that
# announces the newest version; DEPLOY_HOOK_URL is a host rebuild hook, and
# setting it turns the Updates screen's "Update now" button on.
#
# A deploy hook rebuilds CODE only. If a release changes the database,
# `npm run db:migrate` still has to be run.
UPDATE_MANIFEST_URL=
DEPLOY_HOOK_URL=
