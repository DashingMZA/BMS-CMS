# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/.next-verify/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — real secrets live here, .env.example is the template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scheduled backups written by /api/backup. Never commit, never serve.
/backups/

# Installed plugins (uploaded through the admin). Site data, not code.
/plugins/

# Uploaded media. The directory ships, its contents do not — these are the
# site's own files, not part of the CMS, and they need to survive an update.
/public/uploads/*
!/public/uploads/.gitkeep

# NOTE: drizzle/ is deliberately NOT ignored.
#
# It was, in an earlier version of this file, and that was a mistake worth
# recording: those .sql files ARE the database schema. Ignoring them meant a
# fresh clone had no way to build a database, and a schema change could not
# travel with the code that depended on it.

# Font files: Google copies made at run time and fonts uploaded in the Customizer. Site data.
/fonts/
